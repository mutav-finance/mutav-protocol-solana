{
  "name": "@mutav-finance/mutav-protocol-solana",
  "version": "0.1.0",
  "description": "TypeScript client for the MUTAV Solana program. Composes instructions and reads accounts; holds no keys.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutav-finance/mutav-protocol-solana.git",
    "directory": "clients/js"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --format esm --packages external && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "cp ../../LICENSE LICENSE && bun run build"
  },
  "peerDependencies": {
    "@solana/kit": "^8.4.0"
  },
  "devDependencies": {
    "@solana/kit": "8.4.0",
    "@types/bun": "1.3.1",
    "@types/node": "^24.0.0"
  }
}
