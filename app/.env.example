# Cluster: localnet or devnet. Mainnet is refused (lib/cluster.ts). Inlined at build time.
NEXT_PUBLIC_CLUSTER=devnet

# Server-side runtime config (read by the route handlers at request time, so a
# re-seeded localnet needs no rebuild). None of these is secret; an RPC URL with
# an API key stays server-side because it is not NEXT_PUBLIC_.
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=8scC79jkU7SPM9v6M4nB833R8EeqKknfwdRdjn73Qqv9
# VaultConfig PDA of the reserve (["config", reserve_mint]). Devnet: <FILL after initialize>.
CONFIG_ADDRESS=
# Squads v4 multisig whose vault is VaultConfig.admin (optional; /admin falls back to
# direct signing on localnet when the admin is not a Squads vault).
SQUADS_MULTISIG=
# Allowlisted investor wallets (public addresses, comma-separated): must hash to the
# on-chain allowlist root. Used only to build request_deposit Merkle proofs.
ALLOWLIST=
